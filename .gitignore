# Next.js
etf-dashboard/.next/
etf-dashboard/node_modules/
etf-dashboard/.env*

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/

# Data
# We include normalized_holdings.csv because the dashboard depends on it
# but we exclude the raw source files if they are large
*holdings.csv
!normalized_holdings.csv
!etf-dashboard/public/data/history/holdings_*.csv
*.html
!etf-dashboard/public/offline.html

# SQLite scratch DBs — these are rebuilt by the scraper. Committing the
# binary just bloats the repo and the API container uses its own DB
# at api/data/tickertrace.db (also gitignored).
data/holdings.db
# Scraper-generated cache. Like holdings.db above, this is runtime state the
# scraper rebuilds on demand — tracking it made every scrape dirty the tree,
# which is what blocks sync_data.sh's ff-only merge on the Vultr box.
data/cusip_cache.json
data/*.db-journal
api/data/*.db
api/data/*.db-journal
# WAL-mode companion files — created when the API runs (e.g. a local server).
data/*.db-shm
data/*.db-wal
api/data/*.db-shm
api/data/*.db-wal
scraper.log

# yfinance price cache used by the signal-performance backtest. Regenerated
# incrementally; multi-MB derived artifact. The aggregate output JSON it
# produces (etf-dashboard/public/data/signal_performance.json) IS committed.
data/signal_performance_prices.json

# System
.DS_Store
Thumbs.db

# Gemini Artifacts
.gemini/
.vercel
.env*.local
.venv/
.stripe_env
firebase-service-account.json

# Vultr / SSH credentials — never commit these
.env.vultr*
.ssh_keys/
.deploy_vultr.py
deploy_vultr.ps1
push_session.ps1

# Syncthing conflict files
*.sync-conflict-*

# Firebase debug logs
firebase-debug.log

# Root-level credential files — never commit. whop-app/STATUS.md references
# ../.env.whop.txt (a Whop company REST key); the existing `.env*.local` rule
# does not match it. Example files are kept tracked via the negation.
/.env
/.env.*
!/.env*.example

# Anonymous notification worker lock (runtime state)
api/data/notifications.lock
