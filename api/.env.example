# TickerTrace API — Environment Variables
# Copy to .env and fill in your values. All are optional.

# Base URL (used in /docs and links). No trailing slash.
TICKERTRACE_BASE_URL=https://api.tickertrace.mphinance.com

# CORS allowlist. Comma-separated. Defaults to tickertrace.pro / tradermatrix.pro / localhost.
# ALLOWED_ORIGINS=https://tickertrace.pro,https://tradermatrix.pro

# NOTE: Stripe + Firebase were removed in May 2026.
# TickerTrace is fully open / free; monetization happens via TraderMatrix.Pro
# (formerly TraderDaddy.Pro — rebranded September 2026).

# Postgres connection string for the `tickertrace` schema (Railway
# migration, Sep 2026). This schema lives inside a shared Supabase project
# that also hosts an unrelated product's live billing tables in `public` —
# api/auth.py and api/visits.py always schema-qualify their SQL, but this
# value must still point at that project's database. Use the
# pooled/transaction-mode connection string (e.g. Supabase's "Transaction"
# pooler on port 6543, or Railway's equivalent), not a direct connection —
# Railway's app instances are effectively serverless-ish (can scale/restart
# frequently) and a transaction-mode pooler avoids exhausting Postgres's own
# connection limit the way a direct connection per instance/pool would.
# DATABASE_URL=postgresql://user:password@host:6543/postgres
