{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": { "EXPO_PUBLIC_API_URL": "https://api.tickertrace.pro" }
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "channel": "preview",
      // First test APK only: sign with the existing Play upload key kept OUTSIDE the repo.
      // Generate the git-ignored credentials.json with scripts/write-local-credentials.sh and run the
      // build from that machine (CI has no such file). Production uses EAS-hosted credentials.
      "credentialsSource": "local",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_API_URL": "https://api.tickertrace.pro" }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      // Play wants an Android App Bundle (not an APK). Signed with the Play UPLOAD key held by EAS
      // (hosted credentials): upload it once with scripts/play/upload-keystore-to-eas.mjs.
      "android": { "buildType": "app-bundle" },
      // EXPO_PUBLIC_* come from the EAS "production" environment (see docs/PLAY_RELEASE.md). They are
      // also pinned here so a build never depends on that environment being filled in. The notifications client
      // flag is ON (go-live 2026-10-13); it must also exist in the EAS production environment, because
      // `eas update --environment production` ignores eas.json env (docs/NOTIFICATIONS_GO_LIVE.md).
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.tickertrace.pro",
        "EXPO_PUBLIC_NOTIFICATIONS_BACKEND": "1"
      }
    }
  },
  "submit": {
    // Default (decision 2026-10-13): every production build, from a mobile-v* tag or the push-to-main auto-release, is
    // submitted straight to the Play PRODUCTION track. Google review still applies to each one, and a native release cannot be
    // rolled back to a lower versionCode (docs/PLAY_RELEASE.md). The Play service-account key lives on EAS, not in GitHub.
    "production": {
      "android": {
        "track": "production",
        "releaseStatus": "completed"
      }
    },
    // Opt-in internal testing track, only via the eas-ops "submit-android-internal" action.
    "internal": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}
